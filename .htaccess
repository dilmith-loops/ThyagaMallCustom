# Repository root is served at /ThyagaMall/ — send every request into Laravel's public/ directory.
# Nothing outside public/ (app, config, vendor, .env, ...) is reachable from the web.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ThyagaMall/

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback protection if mod_rewrite is unavailable
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(composer\.json|composer\.lock|package\.json|artisan|phpunit\.xml)">
    Order allow,deny
    Deny from all
</FilesMatch>

Options -Indexes
