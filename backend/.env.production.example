APP_NAME="Thyaga Mall"
APP_ENV=production
APP_KEY=base64:EKk9vYWK6kZaoBrlKAaJ1Oe1cYlxvmb+IT4ZuIRe6EU=
APP_DEBUG=false
APP_URL=https://ai.loopsintegrated.co/ThyagaMall/api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
